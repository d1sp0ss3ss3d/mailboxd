{
  "manifest_version": 3,
  "name": "mailboxd",
  "version": "0.1.5",
  "description": "Read your Letterboxd email notifications from the Activity feed.",
  "browser_specific_settings": {
    "safari": { "strict_min_version": "17.0" }
  },
  "permissions": ["nativeMessaging"],
  "background": { "scripts": ["background.js"], "persistent": false },
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/activity",
        "https://letterboxd.com/activity/*"
      ],
      "js": ["activity.js"],
      "css": ["activity.css"],
      "run_at": "document_idle"
    }
  ]
}
